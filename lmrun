#!/usr/bin/env python3
"""lmrun - launch coding agents against local models without touching their real configs.

Each harness runs with an ISOLATED config home (env-var relocation) plus process-scoped
env vars, so ~/.claude, ~/.codex, ~/.config/opencode and ~/.pi are never written.
As a safety net the real config files are snapshotted before launch and restored on
exit if anything changed them anyway.

Usage:
  lmrun claude   [claude args...]     Claude Code   (CLAUDE_CONFIG_DIR isolated)
  lmrun codex    [codex args...]      Codex CLI     (CODEX_HOME isolated)
  lmrun opencode [opencode args...]   OpenCode      (OPENCODE_CONFIG isolated)
  lmrun pi       [pi args...]         Pi agent      (PI_CODING_AGENT_DIR isolated)
  lmrun axio     [axio args...]       Axio          (AXIO_HOME isolated)
  lmrun shell    [cmd...]             subshell with the local-model env exported
  lmrun env                           print export lines (eval "$(lmrun env)")
  lmrun status                        server reachability + models
  lmrun serve                         start oMLX if it is not running (Mac only)
  lmrun list                          harnesses found on PATH and model roles
  lmrun reset <harness>               delete that harness's isolated home
  lmrun snapshots                     list snapshots taken by the safety net

Options (before the harness name):
  -o/--orchestrator MODEL   main model      (default from config)
  -w/--worker MODEL         subagent model  (default from config)
  --url URL                 server base URL (default: auto-detect)
  --shared                  use the REAL config dir instead of an isolated one
                            (snapshot/restore still protects it)
  --reseed                  re-copy CLAUDE.md/settings/AGENTS.md into the isolated home
  --dry-run                 show env + generated config, do not launch
Config: ~/.config/lmrun/config.json    Env override: LMRUN_URL
"""
import hashlib
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".config", "lmrun")
HOMES = os.path.join(BASE, "homes")
SNAPS = os.path.join(BASE, "snapshots")
CONFIG_PATH = os.path.join(BASE, "config.json")
DEFAULTS = {
    "url": None,
    "token": "local",
    "orchestrator": "Jundot--Qwen3.8-27B-oQ4e-mtp",
    "worker": "gpt-oss-120b-MXFP4-Q8",
    "codex_model": "gpt-oss-120b-MXFP4-Q8",
    "context_window": 131072,
    "max_output": 32768,
    "keep_snapshots": 10,
}
HARNESSES = ("claude", "codex", "opencode", "pi", "axio", "shell")

# Real config files each harness might touch. Snapshotted before launch, restored on exit if changed.
PROTECTED = {
    "claude": [".claude.json", ".claude/settings.json", ".claude/settings.local.json", ".claude/CLAUDE.md",
               ".claude/keybindings.json"],
    "codex": [".codex/config.toml", ".codex/auth.json", ".codex/AGENTS.md"],
    "opencode": [".config/opencode/opencode.json", ".config/opencode/opencode.jsonc",
                 ".local/share/opencode/auth.json"],
    "pi": [".pi/agent/models.json", ".pi/agent/settings.json", ".pi/agent/auth.json"],
    "axio": [".axio/config.toml", ".axio/auth.json"],
}
PROTECTED["shell"] = sorted({p for v in PROTECTED.values() for p in v})


# ---------- helpers ----------
def log(msg):
    sys.stderr.write("lmrun: %s\n" % msg)


def die(msg, code=2):
    log(msg)
    sys.exit(code)


def load_config():
    cfg = dict(DEFAULTS)
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH) as f:
            cfg.update(json.load(f))
    else:
        os.makedirs(BASE, exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            json.dump(DEFAULTS, f, indent=2)
        log("wrote default config to %s" % CONFIG_PATH)
    return cfg


def port_open(host, port, timeout=0.5):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def detect_url(cfg):
    if os.environ.get("LMRUN_URL"):
        return os.environ["LMRUN_URL"].rstrip("/")
    if cfg.get("url"):
        return cfg["url"].rstrip("/")
    if port_open("127.0.0.1", 8000):
        return "http://127.0.0.1:8000"
    for h in ("host.internal", "host.orb.internal", "host.docker.internal"):
        try:
            socket.gethostbyname(h)
        except OSError:
            continue
        if port_open(h, 8000):
            return "http://%s:8000" % h
    return "http://127.0.0.1:8000"


def server_models(url, timeout=3):
    try:
        with urllib.request.urlopen(url + "/v1/models", timeout=timeout) as r:
            return [m["id"] for m in json.load(r).get("data", [])]
    except Exception:
        return None


def maybe_start_server(url):
    if server_models(url) is not None:
        return True
    start = os.path.join(HOME, ".omlx", "start.sh")
    if sys.platform != "darwin" or not os.path.exists(start) or "127.0.0.1" not in url:
        return False
    log("oMLX not running, starting it via %s" % start)
    logf = open(os.path.join(HOME, ".omlx", "server.log"), "ab")
    subprocess.Popen([start], stdout=logf, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(60):
        time.sleep(1)
        if server_models(url) is not None:
            return True
    return False


def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def copy_if(src, dst):
    if os.path.exists(src) and not os.path.exists(dst):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if os.path.isdir(src):
            shutil.copytree(src, dst, symlinks=True)
        else:
            shutil.copy2(src, dst)
        return True
    return False


# ---------- snapshot / restore safety net ----------
class Guard:
    def __init__(self, harness, keep):
        self.paths = [os.path.join(HOME, p) for p in PROTECTED[harness]]
        self.snap = os.path.join(SNAPS, "%s-%s" % (datetime.now().strftime("%Y%m%d-%H%M%S"), harness))
        self.before = {}
        self.keep = keep

    def take(self):
        os.makedirs(self.snap, exist_ok=True)
        for p in self.paths:
            if os.path.isfile(p):
                self.before[p] = sha(p)
                dst = os.path.join(self.snap, os.path.relpath(p, HOME))
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copy2(p, dst)
        with open(os.path.join(self.snap, "manifest.json"), "w") as f:
            json.dump(self.before, f, indent=2)
        self._prune()

    def restore(self):
        changed, created = [], []
        for p in self.paths:
            was = self.before.get(p)
            if was is None:
                if os.path.isfile(p):
                    created.append(p)
                continue
            if not os.path.isfile(p) or sha(p) != was:
                src = os.path.join(self.snap, os.path.relpath(p, HOME))
                os.makedirs(os.path.dirname(p), exist_ok=True)
                shutil.copy2(src, p)
                changed.append(p)
        if changed:
            log("RESTORED %d real config file(s) the harness modified:" % len(changed))
            for p in changed:
                log("  %s  (snapshot kept in %s)" % (p, self.snap))
        if created:
            log("note: new file(s) appeared in real config dirs (left in place): %s" % ", ".join(created))
        if not changed and not created:
            log("real configs untouched (%d file(s) verified)" % len(self.before))

    def _prune(self):
        snaps = sorted(d for d in os.listdir(SNAPS) if os.path.isdir(os.path.join(SNAPS, d)))
        for d in snaps[:-self.keep] if self.keep > 0 else []:
            shutil.rmtree(os.path.join(SNAPS, d), ignore_errors=True)


# ---------- per-harness environment builders ----------
def base_env(url, cfg, orch, worker):
    env = dict(os.environ)
    env.pop("ANTHROPIC_API_KEY", None)
    env.update({
        "LMRUN": "1", "LMRUN_URL": url,
        "LMRUN_ORCHESTRATOR": orch, "LMRUN_WORKER": worker,
        "OMLX_API_KEY": cfg["token"],
        # generic OpenAI-compatible clients (aider, llm, etc.)
        "OPENAI_BASE_URL": url + "/v1", "OPENAI_API_BASE": url + "/v1", "OPENAI_API_KEY": cfg["token"],
        # generic Anthropic-compatible clients
        "ANTHROPIC_BASE_URL": url, "ANTHROPIC_AUTH_TOKEN": cfg["token"],
    })
    return env


def build_claude(url, cfg, orch, worker, home, shared, reseed):
    env = base_env(url, cfg, orch, worker)
    env.update({
        "ANTHROPIC_MODEL": orch,
        "ANTHROPIC_DEFAULT_OPUS_MODEL": orch, "ANTHROPIC_DEFAULT_SONNET_MODEL": orch,
        "ANTHROPIC_DEFAULT_FABLE_MODEL": orch, "ANTHROPIC_DEFAULT_HAIKU_MODEL": worker,
        "CLAUDE_CODE_SUBAGENT_MODEL": worker,
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1", "DISABLE_TELEMETRY": "1", "DISABLE_AUTOUPDATER": "1",
    })
    notes = []
    if not shared:
        env["CLAUDE_CONFIG_DIR"] = home
        os.makedirs(home, exist_ok=True)
        real = os.path.join(HOME, ".claude")
        if reseed:
            for n in ("CLAUDE.md", "settings.json", "skills", "agents", "commands"):
                p = os.path.join(home, n)
                shutil.rmtree(p, ignore_errors=True) if os.path.isdir(p) else (os.path.exists(p) and os.remove(p))
        seeded = [n for n in ("CLAUDE.md", "settings.json", "skills", "agents", "commands")
                  if copy_if(os.path.join(real, n), os.path.join(home, n))]
        cj = os.path.join(home, ".claude.json")
        if not os.path.exists(cj):
            state = {"hasCompletedOnboarding": True}
            try:
                with open(os.path.join(HOME, ".claude.json")) as f:
                    real_state = json.load(f)
                for k in ("theme", "preferredNotifChannel", "editorMode", "autoUpdates"):
                    if k in real_state:
                        state[k] = real_state[k]
            except Exception:
                pass
            with open(cj, "w") as f:
                json.dump(state, f, indent=2)
            seeded.append(".claude.json")
        if seeded:
            notes.append("seeded isolated Claude home with: " + ", ".join(seeded))
    return env, [], notes


def build_codex(url, cfg, orch, worker, home, shared, reseed):
    env = base_env(url, cfg, orch, worker)
    model = cfg.get("codex_model") or worker
    notes = []
    if not shared:
        env["CODEX_HOME"] = home
        os.makedirs(home, exist_ok=True)
        toml = (
            '# generated by lmrun - safe to delete\n'
            'model = "%s"\n'
            'model_provider = "omlx"\n'
            'model_context_window = %d\n'
            'model_reasoning_effort = "medium"\n'
            '\n[model_providers.omlx]\n'
            'name = "oMLX (local)"\n'
            'base_url = "%s/v1"\n'
            'env_key = "OMLX_API_KEY"\n'
            'wire_api = "responses"\n'
            'request_max_retries = 2\n'
            'stream_idle_timeout_ms = 600000\n'
        ) % (model, cfg["context_window"], url)
        with open(os.path.join(home, "config.toml"), "w") as f:
            f.write(toml)
        if reseed and os.path.exists(os.path.join(home, "AGENTS.md")):
            os.remove(os.path.join(home, "AGENTS.md"))
        if copy_if(os.path.join(HOME, ".codex", "AGENTS.md"), os.path.join(home, "AGENTS.md")):
            notes.append("seeded isolated Codex home with AGENTS.md")
        return env, [], notes
    # shared mode: override on the CLI only, never write ~/.codex/config.toml
    extra = ["-c", 'model_provider="omlx"', "-c", 'model="%s"' % model,
             "-c", 'model_providers.omlx.name="oMLX (local)"',
             "-c", 'model_providers.omlx.base_url="%s/v1"' % url,
             "-c", 'model_providers.omlx.env_key="OMLX_API_KEY"',
             "-c", 'model_providers.omlx.wire_api="responses"']
    return env, extra, notes


def build_opencode(url, cfg, orch, worker, home, shared, reseed):
    env = base_env(url, cfg, orch, worker)
    notes = []
    if not shared:
        os.makedirs(home, exist_ok=True)
        conf = {
            "$schema": "https://opencode.ai/config.json",
            "model": "omlx/%s" % orch,
            "small_model": "omlx/%s" % worker,
            "provider": {
                "omlx": {
                    "npm": "@ai-sdk/openai-compatible",
                    "name": "oMLX (local)",
                    "options": {"baseURL": url + "/v1", "apiKey": "{env:OMLX_API_KEY}"},
                    "models": {
                        m: {"name": m, "limit": {"context": cfg["context_window"], "output": cfg["max_output"]}}
                        for m in sorted({orch, worker})
                    },
                }
            },
        }
        path = os.path.join(home, "opencode.json")
        with open(path, "w") as f:
            json.dump(conf, f, indent=2)
        env["OPENCODE_CONFIG"] = path
        notes.append("note: OpenCode still merges ~/.config/opencode/opencode.json underneath (read-only for us)")
        return env, [], notes
    return env, ["--model", "omlx/%s" % orch], ["shared mode: provider 'omlx' must already exist in your real opencode.json"]


def build_pi(url, cfg, orch, worker, home, shared, reseed):
    env = base_env(url, cfg, orch, worker)
    notes = []
    models = [{"id": m, "name": m, "contextWindow": cfg["context_window"], "maxTokens": cfg["max_output"],
               "input": ["text"], "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}}
              for m in sorted({orch, worker})]
    if not shared:
        os.makedirs(home, exist_ok=True)
        with open(os.path.join(home, "models.json"), "w") as f:
            json.dump({"providers": {"omlx": {"baseUrl": url + "/v1", "api": "openai-completions",
                                              "apiKey": "$OMLX_API_KEY", "models": models}}}, f, indent=2)
        env["PI_CODING_AGENT_DIR"] = home
        return env, ["--provider", "omlx", "--model", orch], notes
    return env, ["--provider", "omlx", "--model", orch], ["shared mode: provider 'omlx' must already exist in ~/.pi/agent/models.json"]


def build_axio(url, cfg, orch, worker, home, shared, reseed):
    # axio: [model] provider/base_url/model in $AXIO_HOME/config.toml, or AXIO_* env vars (env outranks file).
    env = base_env(url, cfg, orch, worker)
    env.update({"AXIO_PROVIDER": "openai-compatible", "AXIO_BASE_URL": url + "/v1", "AXIO_MODEL": orch,
                "OLLAMA_API_KEY": cfg["token"]})
    notes = []
    if not shared:
        env["AXIO_HOME"] = home
        os.makedirs(home, exist_ok=True)
        with open(os.path.join(home, "config.toml"), "w") as f:
            f.write('# generated by lmrun - safe to delete\n[model]\nprovider = "openai-compatible"\n'
                    'base_url = "%s/v1"\nmodel = "%s"\neffort = "medium"\n\n[worktree]\nenabled = false\n'
                    % (url, orch))
        return env, [], notes
    return env, [], ["shared mode: AXIO_* env vars override ~/.axio/config.toml for this run only"]


def build_shell(url, cfg, orch, worker, home, shared, reseed):
    env = base_env(url, cfg, orch, worker)
    env["PS1"] = "(lmrun) " + env.get("PS1", "\\$ ")
    return env, [], ["subshell: any tool you start here inherits the local-model env; exit to restore"]


BUILDERS = {"claude": build_claude, "codex": build_codex, "opencode": build_opencode, "pi": build_pi,
            "axio": build_axio, "shell": build_shell}


# ---------- launch ----------
def run_child(argv, env, guard):
    # Parent ignores SIGINT so Ctrl+C reaches only the child; parent survives to restore configs.
    child = subprocess.Popen(argv, env=env)
    prev_int = signal.signal(signal.SIGINT, signal.SIG_IGN)

    def forward(signum, frame):
        try:
            child.send_signal(signum)
        except OSError:
            pass
    prev_term = signal.signal(signal.SIGTERM, forward)
    prev_hup = signal.signal(signal.SIGHUP, forward)
    try:
        return child.wait()
    finally:
        signal.signal(signal.SIGINT, prev_int)
        signal.signal(signal.SIGTERM, prev_term)
        signal.signal(signal.SIGHUP, prev_hup)
        guard.restore()


def cmd_launch(harness, args, opts, cfg):
    url = opts["url"] or detect_url(cfg)
    orch, worker = opts["orch"] or cfg["orchestrator"], opts["worker"] or cfg["worker"]
    if not opts["dry"]:
        if not maybe_start_server(url):
            die("no model server reachable at %s (start it with: lmrun serve, or set --url / LMRUN_URL)" % url)
        avail = server_models(url) or []
        for role, m in (("orchestrator", orch), ("worker", worker)):
            if m not in avail:
                log("WARNING: %s model %r is not served by %s (available: %s)" % (role, m, url, ", ".join(avail) or "none"))
    exe = "shell" if harness == "shell" else shutil.which(harness)
    if harness == "shell":
        exe = os.environ.get("SHELL", "/bin/sh")
    if not exe:
        die("%s is not on PATH" % harness)
    home = os.path.join(HOMES, harness)
    env, extra, notes = BUILDERS[harness](url, cfg, orch, worker, home, opts["shared"], opts["reseed"])
    if harness == "shell" and args:
        argv = [exe, "-c", " ".join(args)]
    else:
        argv = [exe] + extra + args
    for n in notes:
        log(n)
    log("server=%s  orchestrator=%s  worker=%s  mode=%s" % (url, orch, worker, "SHARED real config" if opts["shared"] else "isolated home %s" % home))
    if opts["dry"]:
        print("# argv:", " ".join(argv))
        for k in sorted(env):
            if k.startswith(("LMRUN", "ANTHROPIC", "CLAUDE", "OPENAI", "OMLX", "CODEX", "OPENCODE", "PI_", "AXIO", "OLLAMA", "DISABLE")):
                print("export %s=%s" % (k, json.dumps(env[k])))
        for gen in ("config.toml", "opencode.json", "models.json"):
            p = os.path.join(home, gen)
            if os.path.exists(p) and not opts["shared"]:
                print("\n# %s\n%s" % (p, open(p).read()))
        return 0
    guard = Guard(harness, cfg["keep_snapshots"])
    guard.take()
    if opts["shared"]:
        log("SHARED mode: the real config dir is in use; it will be restored from %s on exit" % guard.snap)
    return run_child(argv, env, guard)


# ---------- info commands ----------
def cmd_env(cfg, opts):
    url = opts["url"] or detect_url(cfg)
    env, _, _ = build_claude(url, cfg, opts["orch"] or cfg["orchestrator"], opts["worker"] or cfg["worker"],
                             os.path.join(HOMES, "claude"), True, False)
    for k in sorted(env):
        if k.startswith(("LMRUN", "ANTHROPIC", "CLAUDE_CODE", "OPENAI", "OMLX", "DISABLE")):
            print("export %s=%s" % (k, json.dumps(env[k])))
    print("unset ANTHROPIC_API_KEY")


def cmd_status(cfg, opts):
    url = opts["url"] or detect_url(cfg)
    models = server_models(url)
    print("server:       %s  (%s)" % (url, "UP" if models is not None else "DOWN"))
    print("orchestrator: %s%s" % (cfg["orchestrator"], "" if models is None or cfg["orchestrator"] in models else "  [NOT SERVED]"))
    print("worker:       %s%s" % (cfg["worker"], "" if models is None or cfg["worker"] in models else "  [NOT SERVED]"))
    if models:
        print("served:       " + ", ".join(models))
    print("config:       %s" % CONFIG_PATH)
    return 0 if models is not None else 1


def cmd_list(cfg):
    for h in HARNESSES:
        if h == "shell":
            continue
        exe = shutil.which(h)
        home = os.path.join(HOMES, h)
        print("%-9s %-50s isolated home: %s" % (h, exe or "(not on PATH)", "yes" if os.path.isdir(home) else "not yet"))
    print("shell     subshell with env exported")


def cmd_serve(cfg, opts):
    url = opts["url"] or detect_url(cfg)
    if maybe_start_server(url):
        print("server up at %s: %s" % (url, ", ".join(server_models(url) or [])))
        return 0
    die("could not start a server for %s" % url)


def cmd_reset(h):
    if h not in HARNESSES:
        die("unknown harness %r" % h)
    p = os.path.join(HOMES, h)
    if os.path.isdir(p):
        shutil.rmtree(p)
        print("removed", p)
    else:
        print("nothing to remove at", p)


def cmd_snapshots():
    if not os.path.isdir(SNAPS):
        print("no snapshots")
        return
    for d in sorted(os.listdir(SNAPS)):
        print(os.path.join(SNAPS, d))


# ---------- main ----------
def main(argv):
    opts = {"orch": None, "worker": None, "url": None, "shared": False, "reseed": False, "dry": False}
    args = list(argv)
    while args and args[0].startswith("-"):
        a = args.pop(0)
        if a in ("-o", "--orchestrator"):
            opts["orch"] = args.pop(0)
        elif a in ("-w", "--worker"):
            opts["worker"] = args.pop(0)
        elif a == "--url":
            opts["url"] = args.pop(0).rstrip("/")
        elif a == "--shared":
            opts["shared"] = True
        elif a == "--reseed":
            opts["reseed"] = True
        elif a == "--dry-run":
            opts["dry"] = True
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            die("unknown option %s (use --help)" % a)
    if not args:
        print(__doc__)
        return 0
    cfg = load_config()
    cmd, rest = args[0], args[1:]
    if cmd in HARNESSES:
        return cmd_launch(cmd, rest, opts, cfg)
    if cmd == "env":
        return cmd_env(cfg, opts)
    if cmd == "status":
        return cmd_status(cfg, opts)
    if cmd == "list":
        return cmd_list(cfg)
    if cmd == "serve":
        return cmd_serve(cfg, opts)
    if cmd == "reset":
        return cmd_reset(rest[0] if rest else "")
    if cmd == "snapshots":
        return cmd_snapshots()
    die("unknown command %r (use --help)" % cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
